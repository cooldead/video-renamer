# Maintainer: cooldead
pkgname=video-renamer
pkgver=1.3.0
pkgrel=1
pkgdesc="Preview and rename videos, rip discs with MakeMKV, export to a NAS"
arch=('any')
url="https://github.com/cooldead/video-renamer"
license=('MIT')
depends=('python' 'pyside6' 'mpv' 'python-mpv')
optdepends=('makemkv: rip discs'
            'mkvtoolnix-cli: remove unticked tracks after ripping'
            'rsync: export to a NAS'
            'ffmpeg: video lengths for TheDiscDB when mkvmerge is missing')
makedepends=('git')
source=("git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

check() {
  cd "$pkgname"
  python -m unittest
}

package() {
  cd "$pkgname"
  sh packaging/install.sh "$pkgdir" /usr
}
